# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 等級表など公式データの受け渡し用（コミットしない）
tmp-data/

# Playwright の実行結果（期待画像 e2e/__screenshots__ はコミットする）
/test-results/
/playwright-report/

# UI レビューサイクルの撮影画像（pnpm ui:capture の出力。レビュー記録は docs/ui-reviews/ に残す）
/reviews/
